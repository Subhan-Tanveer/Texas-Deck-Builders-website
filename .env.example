# ─────────────────────────────────────────────────────────────
# Texas Deck Builders — environment variables
# Copy this file to `.env.local` and fill in real values.
# ─────────────────────────────────────────────────────────────

# Public site URL (used for canonical tags, sitemap, OpenGraph).
NEXT_PUBLIC_SITE_URL=https://www.texasdeckbuilders.com

# ── Quote-form email (nodemailer / SMTP) ──────────────────────
# Where quote requests are delivered (Duke's inbox).
QUOTE_TO_EMAIL=duke@texasdeckbuilders.com
# From address shown on the notification email.
QUOTE_FROM_EMAIL=website@texasdeckbuilders.com

# SMTP transport. Works with Gmail (app password), SendGrid, Mailgun,
# Amazon SES, Resend SMTP, etc. If these are left blank the API route
# still returns success and logs the payload to the server console so
# the form is testable in local dev without a mail provider.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# ── Live Google reviews (optional) ────────────────────────────
# The reviews widget shows curated reviews out of the box. To pull
# LIVE reviews, add a Google Places API key + the Place ID for the
# Texas Deck Builders Google Business Profile. See README.md.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
